# Copy to .env for local use. Never commit .env.
APP_ENV=local
API_PORT=8080
PAYMENT_STUB_URL=http://payment-stub:8081
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://dynamodb:8000
QUEUE_ENDPOINT=http://localstack:4566
INVENTORY_TABLE=ticketing-inventory
ORDERS_TABLE=ticketing-orders
IDEMPOTENCY_TABLE=ticketing-idempotency
QUEUE_NAME=ticketing-orders
DLQ_NAME=ticketing-orders-dlq
RESERVATION_HOLD_SECONDS=120
PAYMENT_TIMEOUT_SECONDS=2
WORKER_WAIT_SECONDS=5
DYNAMODB_LOCAL_VERSION=2.6.1
LOCALSTACK_VERSION=4.0.3
LOG_LEVEL=INFO
